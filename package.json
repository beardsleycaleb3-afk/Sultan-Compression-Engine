{
  "name": "sultan-compression-engine",
  "version": "88.0.0",
  "description": "Sultan-v88 Geometric Compression Engine",
  "scripts": {
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
